<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="55sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIMBRE INTELIGENTE"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/txtBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenido"
            android:textSize="17sp"
            android:textColor="#263238"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnPreferencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurar preferencias"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#17365D"
            android:onClick="onPreferenciasClick"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnVerLecturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver historial del timbre"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#2196F3"
            android:onClick="onVerLecturasClick" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proyecto IoT - INACAP"
            android:textColor="#607D8B"
            android:textSize="13sp"
            android:layout_marginTop="25dp" />

    </LinearLayout>

</ScrollView>
