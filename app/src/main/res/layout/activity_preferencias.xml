<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 Preferencias del Timbre"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configura las opciones de tu timbre inalámbrico."
            android:textSize="16sp"
            android:textColor="#455A64"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <Switch
            android:id="@+id/switchAlertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activar alertas del timbre"
            android:textSize="17sp"
            android:textColor="#263238"
            android:minHeight="48dp"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación del timbre"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/spinnerUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btnGuardarPreferencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar preferencias"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:backgroundTint="#17365D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proyecto Timbre Inteligente - INACAP"
            android:textColor="#607D8B"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="35dp" />

    </LinearLayout>

</ScrollView>
