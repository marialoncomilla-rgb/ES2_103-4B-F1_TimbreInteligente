<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="45sp"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtTituloFormulario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nuevo evento del timbre"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#17365D"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación del timbre"
            android:textSize="16sp"
            android:textColor="#263238" />

        <EditText
            android:id="@+id/edtUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Entrada principal"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de evento"
            android:textSize="16sp"
            android:textColor="#263238" />

        <EditText
            android:id="@+id/edtTipoEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Visita"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Duración del sonido (segundos)"
            android:textSize="16sp"
            android:textColor="#263238" />

        <EditText
            android:id="@+id/edtDuracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 3.5"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha y hora del evento"
            android:textSize="16sp"
            android:textColor="#263238" />

        <EditText
            android:id="@+id/edtFechaHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 08/10/2026 17:00"
            android:inputType="text"
            android:minHeight="48dp"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/btnGuardarLectura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar evento"
            android:textAllCaps="false"
            android:textSize="17sp"
            android:backgroundTint="#17365D"
            android:onClick="onGuardarLecturaClick" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Timbre Inteligente - INACAP"
            android:textSize="13sp"
            android:textColor="#607D8B"
            android:gravity="center"
            android:layout_marginTop="25dp" />

    </LinearLayout>

</ScrollView>
